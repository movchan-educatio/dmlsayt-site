  "h_artifacts": {
    "arkhiv": [
      {
        "line": 1,
        "text": "[Вітаємо з початком канікул!](#h.vnlaleksf2b1)"
      },
      {
        "line": 3,
        "text": "[Різдво у Дмитрушківському ліцеї](#h.g98j6t3qxq74)"
      },
      {
        "line": 5,
        "text": "[100 днів у школі](#h.rsd2dtjis816)"
      },
      {
        "line": 7,
        "text": "[Зимова казка від \"Радості\"](#h.fkdayvwxougu)"
      },
      {
        "line": 9,
        "text": "[🫖 День чаю☕️](#h.sj4rcurzmadc)"
      },
      {
        "line": 11,
        "text": "[Уманська галактика](#h.exf93dpk23u2)"
      },
      {
        "line": 13,
        "text": "[Конкурс малюнків](#h.cq3g6i2wi2il)"
      },
      {
        "line": 15,
        "text": "[Права свої знай – та про правила й обов'язки не забувай](#h.y6b4vjfvoz2c)"
      },
      {
        "line": 17,
        "text": "[АКТИВУЙ СВОЮ ШКОЛУ](#h.k5kezmut4k5y)"
      },
      {
        "line": 19,
        "text": "[Подарунки та розваги від Святого Миколая](#h.982zh98u9ti0)"
      },
      {
        "line": 21,
        "text": "[День волонтера у Дмитрушківському ліцеї](#h.bu6psigtpu63)"
      },
      {
        "line": 23,
        "text": "[акція \"Подарунок для захисника!\"](#h.lzq94f1qau5y)"
      },
      {
        "line": 25,
        "text": "[Зимовий адвент календар](#h.f7nyn29x1izi)"
      },
      {
        "line": 27,
        "text": "[#16 днів проти насилля](#h.l2p01fw9cfx8)"
      },
      {
        "line": 29,
        "text": "[#Всесвітній день боротьби зі СНІДом](#h.nz0ofkmt6y0d)"
      },
      {
        "line": 31,
        "text": "[Безпечні соціальні мережі](#h.6tr717vzlmk8)"
      },
      {
        "line": 33,
        "text": "[Змагання з волейболу дівчата 9 – 11 класи](#h.vwnn9nxkqo9x)"
      },
      {
        "line": 35,
        "text": "[Всеукраїнський флешмоб](#h.fvwk30ri24mu)"
      },
      {
        "line": 37,
        "text": "[\"Лапка підтримки\"](#h.2qmim5ls78lx)"
      },
      {
        "line": 39,
        "text": "[зібрання учасників літературного клубу \"Фізаліс\"](#h.iqkqvb598sh1)"
      },
      {
        "line": 41,
        "text": "[Калита хай ясно сяє, Україну прославляє!](#h.i32uxwq1utoo)"
      },
      {
        "line": 43,
        "text": "[Підсумки Всеукраїнської учнівської олімпіади з географії](#h.hr077gn1orw8)"
      },
      {
        "line": 45,
        "text": "[Запали свічку пам'яті](#h.8b75dlgp6nx9)"
      },
      {
        "line": 47,
        "text": "[Найкращий знавець\" законів , закономірностей географічного середовища](#h.hw575izdx54d)"
      },
      {
        "line": 49,
        "text": "[День гідності та свободи](#h.yjqpbjeqpxl3)"
      },
      {
        "line": 51,
        "text": "[1000 днів незламності України](#h.dbew7xnsi2g1)"
      },
      {
        "line": 53,
        "text": "[16 днів проти насильства](#h.ft1nfpgtnuit)"
      },
      {
        "line": 55,
        "text": "[Тренінг-гра для першачків](#h.ccmliinh3f5k)"
      },
      {
        "line": 57,
        "text": "[Міжнародний день толерантності](#h.8xyxqjc8971s)"
      },
      {
        "line": 59,
        "text": "[Всеукраїнська учнівська олімпіада з англійської мови](#h.pb49abxmbmbp)"
      },
      {
        "line": 61,
        "text": "[Вітаємо нового президента ліцею](#h.lm5mtid2w7uo)"
      },
      {
        "line": 63,
