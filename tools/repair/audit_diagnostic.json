      {
        "line": 91,
        "text": "[Вітаємо Ніну Іванівну з перемогою у конкурсі](#h.5zv5jdus0dml)"
      },
      {
        "line": 93,
        "text": "[Відкриття Алеї Пам'яті](#h.uakej23dt9e6)"
      },
      {
        "line": 95,
        "text": "[День вшанування пам'яті дітей](#h.otcn2htmnhkp)"
      },
      {
        "line": 97,
        "text": "[Перша допомога від Червоного Хреста](#h.noo06ponk7wz)"
      },
      {
        "line": 99,
        "text": "[Останній дзвінок 2024](#h.64sdpt4mk9jp)"
      },
      {
        "line": 101,
        "text": "[\"New festival of arts-2024\"](#h.28m711g4iykm)"
      },
      {
        "line": 103,
        "text": "[Як Дмитрушківський ліцей весну зустрічав](#h.z0atkhhiyo2e)"
      },
      {
        "line": 105,
        "text": "[День Космонавтики](#h.thuz3uewwdov)"
      },
      {
        "line": 107,
        "text": "[Фестиваль дитячої та юнацької творчості TORONTO 2024](#h.qej81ayleebo)"
      },
      {
        "line": 109,
        "text": "[Навчання навичкам першої допомоги](#h.4ff8o9qhd6we)"
      },
      {
        "line": 111,
        "text": "[Літературний хаб у дмитрушківському ліцеї](#h.wflnucye6513)"
      },
      {
        "line": 113,
        "text": "[Міжнародний день щастя](#h.6cqfuopq4rm)"
      },
      {
        "line": 115,
        "text": "[Базові навички турботи про себе та інших](#h.udtvh19kq0n)"
      },
      {
        "line": 117,
        "text": "[Меморандум про співпрацю з Ірпінським податковим університетом](#h.lfgi8kdb6kr2)"
      },
      {
        "line": 119,
        "text": "[«Змінотворці»](#h.6inncnhg9j8l)"
      },
      {
        "line": 121,
        "text": "[Допомога від членів організації Vsi Razom - All together](#h.vvuqeevfqgzx)"
      },
      {
        "line": 123,
        "text": "[Шевченківські дні](#h.v6yqr3ke92ny)"
      },
      {
        "line": 125,
        "text": "[Весняна толока](#h.34n4gwjkzw1i)"
      },
      {
        "line": 127,
        "text": "[Збір Марка Стронга завершений!](#h.mgg23a6somgc)"
      },
      {
        "line": 129,
        "text": "[Міс україночка Дмитрушківського ліцею 2024](#h.ty6u6o6w6zfj)"
      },
      {
        "line": 131,
        "text": "[Буккросинг](#h.ewnwexxerjfs)"
      },
      {
        "line": 133,
        "text": "[Незламна українська жінка](#h.nklyx5odmmo2)"
      },
      {
        "line": 135,
        "text": "[ІІ етап змагань з футзалу \"Пліч-о-пліч Всеукраїнські шкільні ліги\"](#h.tnuoi31e3qeo)"
      },
      {
        "line": 137,
        "text": "[Працюємо. Навчаємо. Переможемо!](#h.rd607kyzboem)"
      },
      {
        "line": 139,
        "text": "[День народження ліцею](#h.xaxcjeea6rpd)"
      },
      {
        "line": 141,
        "text": "[Виставка гуртків «Народні ремесла України» та «Моделювання іграшок-сувенірів»](#h.iuuakrrk9d1i)"
      },
      {
        "line": 143,
        "text": "[Шкільний урок волонтерства](#h.cwil2i4r9ygo)"
      },
      {
        "line": 145,
        "text": "[Міжнародний день рідної мови](#h.b2b7mtjqmw4s)"
      },
      {
        "line": 147,
        "text": "[Памʼять Героїв Небесної Сотні](#h.lnc5rlgtsbcb)"
      },
      {
        "line": 149,
        "text": "[Шлях до Перемоги](#h.5gh3z0mwitz5)"
      },
      {
        "line": 151,
        "text": "[Міжнародний конкурс з інформатики \"Бебрас\"](#h.bztro8ismy)"
      },
      {
        "line": 153,
        "text": "[День Державного герба України](#h.utey4ka22ayp)"
      },
      {
        "line": 155,
        "text": "[День єднання](#h.tw7l5sisjtvl)"
      },
      {
        "line": 157,
        "text": "[День Святого Валентина](#h.r2swfqqsz841)"
      },
      {
        "line": 159,
        "text": "[Яка ти козачка? Який ти козак?](#h.vuuhqw34wj61)"
      },
      {
        "line": 161,
        "text": "[Ризики мін та вибухонебезпечних предметів](#h.lx27l31wdbh9)"
      },
      {
        "line": 163,
        "text": "[Тиждень безпечного інтернету](#h.q4l8gt3dqwdz)"
      },
      {
        "line": 165,
        "text": "[Всесвітній день читання вголос](#h.p46es2hqkol7)"
      },
      {
        "line": 167,
        "text": "[Сітка для наших захисників](#h.8yenuge0dpcu)"
      },
      {
        "line": 169,
        "text": "[9 лютого - Всесвітній день піци](#h.8ueeat5onurg)"
      },
      {
        "line": 171,
