rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /feedback/{feedbackId} {
      // ПУБЛІЧНІ КОРИСТУВАЧІ:
      // Можуть СТВОРЮВАТИ нові звернення виключно за встановленою схемою
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'message', 'createdAt', 'status'])
                    && request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'message', 'createdAt', 'status'])
                    && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 100
                    && request.resource.data.email is string && request.resource.data.email.size() >= 5 && request.resource.data.email.size() <= 100
                    && (request.resource.data.phone is string ? request.resource.data.phone.size() <= 25 : true)
                    && request.resource.data.message is string && request.resource.data.message.size() >= 10 && request.resource.data.message.size() <= 3000
                    && request.resource.data.status == 'new'
                    && request.resource.data.createdAt == request.time;

      // ПУБЛІЧНИЙ ДОСТУП ЗАБОРОНЕНО:
      // Читати, видаляти або змінювати існуючі звернення може ТІЛЬКИ авторизований адміністратор через Firebase Auth
      allow read, delete: if request.auth != null;

      // Оновлювати дозволено тільки поле status адміністратору
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                    && (request.resource.data.status == 'new' || request.resource.data.status == 'processed');
    }
  }
}
